@model NexaWork.Authentication.Models.ManageViewModels.ShowRecoveryCodesViewModel
@{
    ViewData["Title"] = "Recovery codes";
}

<div class="container mt-5">
    <h2>@ViewData["Title"]</h2>
    <div class="alert alert-warning" role="alert">
        <p>
            <strong>Put these codes in a safe place.</strong>
        </p>
        <p>
            If you lose your device and don't have the recovery codes you will lose access to your account.
        </p>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="p-3 bg-light border">
                @for (var row = 0; row < Model.RecoveryCodes.Length; row += 2)
                {
                    <code>@Model.RecoveryCodes[row]</code><text>&nbsp;</text><text>&nbsp;</text><code>@Model.RecoveryCodes[row + 1]</code><br />
                }
            </div>
        </div>
    </div>
    
    <div class="mt-4">
        <a asp-action="Index" class="btn btn-primary">Back to Account</a>
    </div>
</div>
