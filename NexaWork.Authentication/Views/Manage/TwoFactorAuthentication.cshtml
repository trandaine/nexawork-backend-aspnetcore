@using NexaWork.Authentication.Data.IdentityEntities
@{
    ViewData["Title"] = "Security Settings (2FA & Passkeys)";
    var is2faEnabled = ViewData["Is2faEnabled"] as bool? ?? false;
    var recoveryCodesLeft = ViewData["RecoveryCodesLeft"] as int? ?? 0;
    var passkeys = ViewData["Passkeys"] as List<FidoStoredCredential> ?? new List<FidoStoredCredential>();
    var preferredMethod = ViewData["Preferred2faMethod"] as string;
}

<h4 class="card-title">@ViewData["Title"]</h4>
<hr />

<div class="row">
    <!-- Authenticator App Section -->
    <div class="col-md-6 mb-2">
        <div class="card shadow-sm border-info h-100">
            <div class="card-body">
                <h5 class="card-title"><i class="la la-mobile-phone text-info"></i> Authenticator App</h5>
                @if (is2faEnabled)
                {
                    <p class="text-success"><i class="la la-check-circle"></i> Enabled</p>
                    <div class="mb-2">
                        <form asp-action="Disable2fa" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger btn-sm">Disable Authenticator</button>
                        </form>
                    </div>

                    @if (recoveryCodesLeft == 0)
                    {
                        <div class="alert alert-danger p-1">
                            <strong>0 recovery codes left!</strong> You must <a asp-action="GenerateRecoveryCodes">generate a new set</a>.
                        </div>
                    }
                    else if (recoveryCodesLeft <= 3)
                    {
                        <div class="alert alert-warning p-1">
                            <strong>@recoveryCodesLeft recovery codes left.</strong> Consider <a asp-action="GenerateRecoveryCodes">generating more</a>.
                        </div>
                    }
                    else
                    {
                        <form asp-action="GenerateRecoveryCodes" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-warning btn-sm">Reset Recovery Codes</button>
                        </form>
                    }
                }
                else
                {
                    <p class="text-muted">No authenticator app configured. Add one to secure your account.</p>
                    <a asp-action="EnableAuthenticator" class="btn btn-info">Add authenticator app</a>
                }
            </div>
        </div>
    </div>

    <!-- Passkeys Section -->
    <div class="col-md-6 mb-2">
        <div class="card shadow-sm border-primary h-100">
            <div class="card-body">
                <h5 class="card-title"><i class="la la-fingerprint text-primary"></i> Passkeys (WebAuthn)</h5>
                @if (passkeys.Any())
                {
                    <ul class="list-group list-group-flush mb-2">
                        @foreach (var key in passkeys)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div>
                                    <strong>@key.DisplayName</strong><br/>
                                    <small class="text-muted">Registered: @key.RegDate.ToString("MMM dd, yyyy")</small>
                                </div>
                                <form asp-action="RemovePasskey" method="post">
                                    <input type="hidden" name="id" value="@key.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger"><i class="la la-trash"></i></button>
                                </form>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">No passkeys registered. Register your device (TouchID/FaceID) to sign in without a password.</p>
                }
                
                <button class="btn btn-primary" onclick="registerPasskey()">Register a Passkey</button>
            </div>
        </div>
    </div>
</div>

<!-- Preferred Login Method Section -->
@if (is2faEnabled && passkeys.Any())
{
    <div class="row mt-2">
        <div class="col-12">
            <div class="card shadow-sm border-secondary">
                <div class="card-body">
                    <h5 class="card-title"><i class="la la-cog text-secondary"></i> Preferred Authentication Method</h5>
                    <p class="text-muted">Since you have both an Authenticator App and Passkeys registered, choose which one should be asked by default when you log in with a password.</p>
                    
                    <form asp-action="SetPreferred2faMethod" method="post" class="form-inline">
                        <select name="method" class="form-control mr-2 mb-2">
                            <option value="">Ask me every time</option>
                            @if (preferredMethod == "Passkey") { <option value="Passkey" selected>Passkey</option> } else { <option value="Passkey">Passkey</option> }
                            @if (preferredMethod == "TOTP") { <option value="TOTP" selected>Authenticator App</option> } else { <option value="TOTP">Authenticator App</option> }
                        </select>
                        <button type="submit" class="btn btn-secondary mb-2">Save Preference</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/webauthn.js"></script>
}
