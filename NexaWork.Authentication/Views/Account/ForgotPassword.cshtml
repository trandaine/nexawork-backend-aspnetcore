@model NexaWork.Authentication.Models.AccountViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout_2";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-body">
            <section class="row flexbox-container">
                <div class="col-12 d-flex align-items-center justify-content-center">
                    <div class="col-lg-4 col-md-8 col-10 box-shadow-2 p-0">
                        <div class="card border-grey border-lighten-3 m-0">
                            <div class="card-header border-0 pb-0">
                                <div class="card-title text-center">
                                    <div class="p-1">
                                        <h2>NexaWork Security</h2>
                                    </div>
                                </div>
                                <h6 class="card-subtitle line-on-side text-muted text-center font-small-3 pt-2">
                                    <span>Recover Password</span>
                                </h6>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <p class="text-center text-muted">Please enter your email address and we will send you a 6-digit code to reset your password.</p>
                                    
                                    <form method="post" asp-action="ForgotPassword">
                                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                                        
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />

                                        <fieldset class="form-group position-relative has-icon-left">
                                            <input asp-for="Email" class="form-control" autocomplete="off" placeholder="Your Email Address" required />
                                            <div class="form-control-position">
                                                <i class="la la-envelope"></i>
                                            </div>
                                            <span asp-validation-for="Email" class="text-danger"></span>
                                        </fieldset>

                                        <button type="submit" class="btn btn-outline-info btn-block"><i class="la la-key"></i> Recover Password</button>
                                    </form>
                                </div>
                                <div class="card-footer border-0">
                                    <p class="float-sm-left text-center"><a asp-action="Login" asp-route-returnUrl="@returnUrl" class="card-link">Back to Login</a></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>
