@model NexaWork.Authentication.Models.AccountViewModels.LoginWithRecoveryCodeViewModel
@{
    ViewData["Title"] = "Recovery code verification";
    Layout = "_Layout_2";
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-body">
            <section class="row flexbox-container">
                <div class="col-12 d-flex align-items-center justify-content-center">
                    <div class="col-lg-4 col-md-8 col-10 box-shadow-2 p-0">
                        <div class="card border-grey border-lighten-3 m-0">
                            <div class="card-header border-0 pb-0">
                                <div class="card-title text-center">
                                    <div class="p-1">
                                        <h2>NexaWork Security</h2>
                                    </div>
                                </div>
                                <h6 class="card-subtitle line-on-side text-muted text-center font-small-3 pt-2">
                                    <span>Recovery Code Login</span>
                                </h6>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="alert alert-warning mb-3">
                                        You have requested to log in with a recovery code. This login will not be
                                        remembered until you provide an authenticator app code at log in or disable 2FA
                                        and log in again.
                                    </div>

                                    <form method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                                        <fieldset class="form-group position-relative has-icon-left">
                                            <input asp-for="RecoveryCode" class="form-control" autocomplete="off"
                                                   placeholder="e.g. 1a2b-3c4d"/>
                                            <div class="form-control-position">
                                                <i class="la la-life-ring"></i>
                                            </div>
                                            <span asp-validation-for="RecoveryCode" class="text-danger"></span>
                                        </fieldset>

                                        <button type="submit" class="btn btn-outline-warning btn-block"><i
                                                class="la la-unlock"></i> Log in
                                        </button>
                                    </form>
                                    <hr/>
                                    <p class="text-center">
                                        <a asp-action="LoginWith2fa" asp-route-returnUrl="@ViewData["ReturnUrl"]">Return
                                            to Authenticator Login</a>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>
