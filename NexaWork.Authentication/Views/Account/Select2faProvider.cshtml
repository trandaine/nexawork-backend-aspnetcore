@{
    ViewData["Title"] = "Select Authentication Method";
    Layout = "_Layout_2";
    
    // Lookup for enabled 2FA methods
    var hasEmail = ViewData["HasEmail"] as bool? ?? false;
    var hasAuthenticator = ViewData["HasAuthenticator"] as bool? ?? false;
    var hasPasskeys = ViewData["HasPasskeys"] as bool? ?? false;
}

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">
        <div class="content-body">
            <section class="row flexbox-container">
                <div class="col-12 d-flex align-items-center justify-content-center">
                    <div class="col-lg-4 col-md-8 col-10 box-shadow-2 p-0">
                        <div class="card border-grey border-lighten-3 m-0">
                            <div class="card-header border-0 pb-0">
                                <div class="card-title text-center">
                                    <div class="p-1">
                                        <h2>NexaWork Security</h2>
                                    </div>
                                </div>
                                <h6 class="card-subtitle line-on-side text-muted text-center font-small-3 pt-2">
                                    <span>2-Step Verification</span>
                                </h6>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <p class="text-center text-muted">How would you like to receive your security
                                        challenge?</p>

                                    <form method="post" asp-action="Select2faProvider"
                                          asp-route-returnUrl="@ViewData["ReturnUrl"]">

                                        <div class="row text-center my-2">
                                            @if (hasPasskeys)
                                            {
                                                <div class="col-4">
                                                    <button type="submit" name="provider" value="Passkey"
                                                            class="btn btn-outline-primary btn-block p-2"
                                                            style="border-radius: 10px; height: 100%;">
                                                        <i class="la la-fingerprint" style="font-size: 2rem;"></i>
                                                        <br/>
                                                        Passkey
                                                    </button>
                                                </div>
                                            }
                                            @if (hasAuthenticator)
                                            {
                                                <div class="col-4">
                                                    <button type="submit" name="provider" value="TOTP"
                                                            class="btn btn-outline-info btn-block p-2"
                                                            style="border-radius: 10px; height: 100%;">
                                                        <i class="la la-mobile-phone" style="font-size: 2rem;"></i>
                                                        <br/>
                                                        App
                                                    </button>
                                                </div>
                                            }
                                            @if (hasEmail)
                                            {
                                                <div class="col-4">
                                                    <button type="submit" name="provider" value="Email"
                                                            class="btn btn-outline-success btn-block p-2"
                                                            style="border-radius: 10px; height: 100%;">
                                                        <i class="la la-envelope" style="font-size: 2rem;"></i>
                                                        <br/>
                                                        Email
                                                    </button>
                                                </div>
                                            }
                                        </div>

                                        <div class="form-group row mt-2">
                                            <div class="col-12 text-center">
                                                <fieldset>
                                                    <input type="checkbox" name="rememberChoice" value="true"
                                                           class="chk-remember" id="rememberChoice"/>
                                                    <label for="rememberChoice">Remember my preference for next
                                                        time</label>
                                                </fieldset>
                                            </div>
                                        </div>

                                    </form>
                                    <hr/>
                                    <p class="text-center">
                                        <a asp-action="LoginWithRecoveryCode"
                                           asp-route-returnUrl="@ViewData["ReturnUrl"]">Use a recovery code instead</a>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>
